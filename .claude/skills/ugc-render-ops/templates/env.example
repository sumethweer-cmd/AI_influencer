# ตัวอย่างโครงของไฟล์ .env (ไม่มีค่าจริง) — ก๊อปเป็น .env แล้วกรอกเอง
# ห้าม commit .env ห้ามวาง key ในแชท/issue/PR  (.gitignore ต้องมีบรรทัด .env)

# --- RunningHub ---
RUNNINGHUB_API_KEY=
RUNNINGHUB_WORKFLOW_ID=          # workflow id ของ "Motion Context V2" บน RH (ใส่ใน rh.*.config.json ก็ได้)
# RH_COIN_USD=                   # (ไม่บังคับ) ราคาต่อ 1 coin เป็น USD เพื่อคำนวณ cost_usd

# --- RunPod ---
RUNPOD_API_KEY=                  # ใช้ list/stop pod และ --pod auto; ไม่ต้องมี workflow id (RunPod ใช้กราฟ API ใน templates/workflow_api_runpod.json)
# RUNPOD_COMFY_URL=              # (ไม่บังคับ) https://<pod-id>-8188.proxy.runpod.net — หรือส่ง --pod-url ทุกครั้ง

# --- Supabase (ledger + prompt) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # service_role เท่านั้น ใช้ในสคริปต์ในเครื่อง ห้ามใส่ใน frontend
